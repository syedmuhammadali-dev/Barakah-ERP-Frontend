# Local development
NEXT_PUBLIC_API_TARGET=http://127.0.0.1:3002
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (Vercel) - uncomment for production build
# NEXT_PUBLIC_API_TARGET=https://barakah-backend-vert.vercel.app
# NEXT_PUBLIC_SITE_URL=https://barakah-frontend.vercel.app

# Optional: override the desktop app download link shown on the Settings
# page. Defaults to the current Google Drive demo link if unset. Leave
# commented out (not set to an empty string, which would override the
# default with a blank link).
# NEXT_PUBLIC_DESKTOP_APP_URL=